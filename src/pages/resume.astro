---
import Base from '../layouts/Base.astro';

// Two résumés, one per front door. Each renders from src/pages/resume/*.astro and prints
// to its own PDF (npm run pdf).
const resumes = [
  {
    eyebrow: 'industrial engineering',
    title: 'Industrial Engineer',
    blurb:
      'Fabrication-floor and estimating experience at a Michigan countertop manufacturer, the estimating tools I built there, and IE projects in simulation, ergonomics, and facility layout.',
    view: '/resume/engineering',
    pdf: '/Juan_Contreras_Resume_Industrial_Engineer.pdf',
  },
  {
    eyebrow: 'game development',
    title: 'Software Engineer - Games',
    blurb:
      'Gameplay, AI, animation, and save systems in Unreal Engine 5, Unity, and a custom C++/Vulkan stack - four team games and a playable arcade shooter.',
    view: '/resume/games',
    pdf: '/Juan_Contreras_Resume_Game_Developer.pdf',
  },
];
---

<Base
  title="Résumé - Juan Contreras"
  description="Résumés of Juan Contreras, Detroit, MI - an industrial engineering résumé (B.S. ISE, UM-Dearborn) and a game development résumé (B.S. Game Development, Full Sail valedictorian). View online or download the PDF."
  current="resume"
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">// résumé</span>
      <h1 class="section-title">Two résumés</h1>
      <p class="section-subtitle">One for each side of my work. Both are one page and print cleanly.</p>

      <div class="resume-grid">
        {
          resumes.map((r) => (
            <article class="resume-card">
              <span class="card-eyebrow">// {r.eyebrow}</span>
              <h2>{r.title}</h2>
              <p>{r.blurb}</p>
              <div class="card-cta">
                <a class="btn btn-primary" href={r.view}>
                  View résumé
                </a>
                <a class="btn btn-secondary" href={r.pdf} download>
                  Download PDF
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .resume-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .resume-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--red);
    border-radius: var(--radius);
    padding: 1.7rem;
    display: flex;
    flex-direction: column;
  }

  .card-eyebrow {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .resume-card h2 {
    font-size: 1.4rem;
    margin-top: 0.4rem;
  }

  .resume-card p {
    color: var(--text-muted);
    margin-top: 0.7rem;
  }

  .card-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1.4rem;
  }

  @media (max-width: 760px) {
    .resume-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
