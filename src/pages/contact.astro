---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact - Juan Contreras"
  description="Get in touch with Juan Contreras - industrial engineer and game programmer in Detroit, MI. Email, LinkedIn, GitHub, or send a message directly."
  current="contact"
>
  <section class="section contact">
    <div class="container contact-inner">
      <span class="eyebrow">// contact</span>
      <h1 class="section-title">Let's build something</h1>
      <p class="section-subtitle contact-sub">
        Hiring an industrial engineer, a game programmer, or someone who owns problems end to end? I'd love to hear
        about it - based in Detroit, Michigan, open to relocation and remote.
      </p>
      <div class="contact-actions">
        <a class="btn btn-primary btn-large" href="mailto:juan@codejuan.com">juan@codejuan.com</a>
        <a class="btn btn-secondary btn-large" href="https://www.linkedin.com/in/juan-contreras68" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn btn-secondary btn-large" href="https://github.com/Code-Juan" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="btn btn-secondary btn-large" href="/resume">Résumés</a>
      </div>

      <!-- form is a JS-only enhancement (fetch to the API); the buttons above are the no-JS path -->
      <form id="contact-form" class="contact-form" novalidate>
        <p class="form-lead">Or send a message right here:</p>
        <div class="form-row">
          <label>
            <span>name</span>
            <input type="text" name="name" required maxlength="255" autocomplete="name" />
          </label>
          <label>
            <span>email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
        </div>
        <label>
          <span>message</span>
          <textarea name="message" rows="5" required maxlength="5000"></textarea>
        </label>
        <!-- honeypot: hidden from humans, bots fill it and get silently dropped -->
        <div class="hp-wrap" aria-hidden="true">
          <label>
            <span>company website</span>
            <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <button class="btn btn-primary" type="submit">Send message</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact-inner {
    text-align: center;
  }

  .contact-sub {
    margin-left: auto;
    margin-right: auto;
  }

  .contact-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* contact form - JS-only enhancement (fetch submit); hidden without JS so the
     mailto/LinkedIn buttons stay the working path */
  .contact-form {
    display: none;
  }

  :global(html.js) .contact-form {
    display: block;
    max-width: 560px;
    margin: 3rem auto 0;
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem 1.75rem 1.75rem;
  }

  .form-lead {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .form-lead::before {
    content: '// ';
    color: var(--red-text);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .contact-form label {
    display: block;
    margin-top: 1rem;
  }

  .contact-form label span {
    display: block;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    font-family: var(--sans);
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.75rem;
    resize: vertical;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 1px;
  }

  /* honeypot: visually removed, still in the submitted form for bots */
  .hp-wrap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form button {
    margin-top: 1.4rem;
  }

  .contact-form button[disabled] {
    opacity: 0.6;
    cursor: default;
  }

  .form-status {
    margin-top: 1rem;
    font-size: 0.92rem;
    color: var(--text-muted);
    min-height: 1.4em;
  }

  .form-status.ok {
    color: var(--ok);
  }

  .form-status.err {
    color: var(--red-text);
  }

  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // contact form -> api.codejuan.com (same API that serves the services site;
  // the default /api/contact route files submissions under the codejuan client)
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector('.form-status') as HTMLElement;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'form-status';

      if (!form.reportValidity()) return;

      const data = Object.fromEntries(new FormData(form).entries());
      button.disabled = true;
      status.textContent = 'Sending…';

      try {
        const res = await fetch('https://api.codejuan.com/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const body = await res.json().catch(() => ({}));

        if (res.ok && body.success) {
          status.textContent = "Message sent - I'll get back to you soon.";
          status.classList.add('ok');
          form.reset();
        } else {
          status.textContent = (body.error || 'Something went wrong.') + ' You can also email juan@codejuan.com.';
          status.classList.add('err');
        }
      } catch {
        status.textContent = 'Network error - please email juan@codejuan.com instead.';
        status.classList.add('err');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
