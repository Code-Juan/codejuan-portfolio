---
import Base from '../layouts/Base.astro';

// Industrial engineering front door. Case studies live in src/pages/engineering/. Numbers
// come from the source reports and decks (UM-Dearborn coursework, 2021-2023) and from the
// Wooden Stone platform's git history; team work is credited as team work.
interface Card {
  slug: string;
  title: string;
  status: string;
  tech: string;
  meta: string;
  bullets: string[];
  tags: string[];
  // 'contain' for diagrams and charts that must not be cropped; photos fill the frame
  image?: { src: string; alt: string; width: number; height: number; fit?: 'cover' | 'contain' };
}

const work: Card = {
  slug: 'wooden-stone',
  title: 'Estimating & Operations Platform - The Wooden Stone',
  status: 'In production',
  tech: 'Cost estimating · capacity planning · Next.js · Postgres',
  meta: 'March 2025 - present · fabrication floor every week · built with the project manager',
  bullets: [
    'On the fabrication floor every week; estimating and bid prep from product drawings',
    'Wrote the estimating engine that replaced an 8-sheet Excel bid template - checked by 1,400+ automated tests',
    'Fab days set by the bottleneck: the slowest of saw, CNC, and shop square feet per day',
    'CNC priced on machine time per sink cutout; trips planned floor by floor; travel and landed material cost',
    'Bid-performance reports and a sales scorecard - lead conversion, aging, review turnaround',
  ],
  tags: ['Cost estimating', 'Capacity', 'Scheduling', 'KPIs'],
};

const featured: Card[] = [
  {
    slug: 'pharmacy-redesign',
    title: 'Pharmacy Layout Redesign',
    status: 'Senior design · client project',
    tech: 'Siemens Jack · RULA/REBA · Arena · DMAIC · EOQ',
    meta: 'Oct 2022 - Apr 2023 · 4-person team · ergonomics & human factors lead',
    bullets: [
      'A working pharmacy in Dearborn - CornerMed - as the client, with its owner as primary contact',
      'My part: Jack posture studies from 5th-percentile female to 95th-percentile male - RULA lowered at every station',
      'Team Arena study: 8 layout and staffing variants, 2-sample t-tests - at most 4 seconds to gain, so keep the layout',
      'Ordering change instead: 56.3% less safety-stock holding cost',
    ],
    tags: ['Ergonomics', 'Simulation', 'Lean', 'Facilities'],
    image: {
      src: '/images/engineering/pharmacy/storefront-card.webp',
      alt: 'CornerMed Pharmacy storefront in Dearborn',
      width: 960,
      height: 540,
    },
  },
  {
    slug: 'checkout-simulation',
    title: 'Supermarket Checkout Simulation',
    status: 'Discrete-event simulation',
    tech: 'Arena · Input Analyzer · hypothesis testing',
    meta: 'Fall 2022 · 4-person team · Simulation in Systems Design',
    bullets: [
      'Arrival and service-time distributions fit from six weeks of real point-of-sale data',
      '16-station Arena model, validated against observed service time with a t-test',
      'Removing 3 idle self-checkouts: under 3% change in queue, 42% lower estimated annual cost',
    ],
    tags: ['Arena', 'Statistics', 'Cost-benefit'],
    image: {
      src: '/images/engineering/checkout/arena-stations.webp',
      alt: 'Arena model of ten cashier checkout stations',
      width: 932,
      height: 606,
      fit: 'contain',
    },
  },
  {
    slug: 'facility-layout',
    title: 'Lamp Plant Facility Layout',
    status: 'Facilities design',
    tech: 'SLP · from-to & AEIOUX charts · machine & operator sizing',
    meta: 'Winter 2022 · 4-person team · Facilities Design',
    bullets: [
      'Machine counts from standard times with 5% scrap per operation; 12 operators assigned',
      'From-to chart, AEIOUX relationship chart, and SLP placement for a two-floor group layout',
      'Process-flow diagrams for all three product families; material handling and a buy-vs-lease call',
    ],
    tags: ['SLP', 'Material flow', 'Manufacturing'],
    image: {
      src: '/images/engineering/facility/block-layouts.webp',
      alt: 'Two-floor SLP block layouts with numbered departments',
      width: 914,
      height: 280,
      fit: 'contain',
    },
  },
  {
    slug: 'six-sigma',
    title: 'Six Sigma: DMAIC & Process Control',
    status: 'Quality',
    tech: 'Minitab · regression · control charts',
    meta: 'Winter 2022 · 3-person team · Six Sigma & Statistical Process Improvement',
    bullets: [
      'DMAIC material-selection process on public concrete-strength data',
      'Minitab regression (R² about 61%), normality and residual checks, inputs ranked by t-value',
      'Control charts from the course: X-bar/R, NP, and CUSUM',
    ],
    tags: ['Six Sigma', 'Minitab', 'SPC'],
    image: {
      src: '/images/engineering/six-sigma/imr-chart.webp',
      alt: 'I-MR control chart of concrete compressive strength',
      width: 576,
      height: 384,
      fit: 'contain',
    },
  },
];

// Every area of the degree, with where it shows up - the "whole reach" at a glance.
const reach = [
  {
    area: 'Manufacturing processes',
    methods: 'Casting, forming, heat treatment, welding; lab work in tensile testing, steel heat treatment, rolling, composites, and 3D printing',
    evidence: [{ label: 'Fabrication floor at The Wooden Stone', href: '/engineering/wooden-stone' }, { label: 'IMSE 382 Manufacturing Processes' }],
  },
  {
    area: 'Facilities & material flow',
    methods: 'From-to and AEIOUX charts, SLP and graph-based layouts, machine and operator requirements, material handling',
    evidence: [{ label: 'Lamp plant layout', href: '/engineering/facility-layout' }, { label: 'Pharmacy redesign', href: '/engineering/pharmacy-redesign' }],
  },
  {
    area: 'Capacity & scheduling',
    methods: 'Bottleneck-based fab-day capacity, trip planning, aggregate planning, staffing plans',
    evidence: [{ label: 'Estimating engine', href: '/engineering/wooden-stone' }, { label: 'IMSE 4795 Production & Inventory Control' }],
  },
  {
    area: 'Inventory & lean',
    methods: 'Forecasting (regression, rolling sets), EOQ and safety stock, lean manufacturing',
    evidence: [{ label: 'Pharmacy ordering (team)', href: '/engineering/pharmacy-redesign' }, { label: 'IMSE 4795 Production & Inventory Control' }],
  },
  {
    area: 'Quality & Six Sigma',
    methods: 'DMAIC, SIPOC, fishbone, FMEA, control charts (X-bar/R, NP, CUSUM, MR), Minitab regression',
    evidence: [{ label: 'Six Sigma project', href: '/engineering/six-sigma' }, { label: 'Pharmacy DMAIC (team)', href: '/engineering/pharmacy-redesign' }],
  },
  {
    area: 'Simulation',
    methods: 'Arena discrete-event models, Input/Output/Process Analyzer, validation by hypothesis test',
    evidence: [{ label: 'Checkout simulation', href: '/engineering/checkout-simulation' }, { label: 'Pharmacy Arena study (team)', href: '/engineering/pharmacy-redesign' }],
  },
  {
    area: 'Human factors & ergonomics',
    methods: 'RULA, REBA, NIOSH lifting, anthropometric design, Siemens Jack posture analysis',
    evidence: [{ label: 'Pharmacy ergonomics lead', href: '/engineering/pharmacy-redesign' }, { label: 'IMSE 4425 Human Factors labs' }],
  },
  {
    area: 'Operations research',
    methods: 'Linear and integer programs in AMPL (diet, staff scheduling, transportation), network methods',
    evidence: [{ label: 'IMSE 3005 Operations Research' }],
  },
  {
    area: 'Engineering economy',
    methods: 'Annual worth, sensitivity analysis, Monte Carlo risk of loss in Excel; margin and landed-cost models',
    evidence: [{ label: 'Estimating engine', href: '/engineering/wooden-stone' }, { label: 'IMSE 421 Engineering Economy' }],
  },
  {
    area: 'Statistics & data',
    methods: 'Probability and statistics in Minitab; logistic regression in Python (pandas, statsmodels, scikit-learn)',
    evidence: [{ label: 'IMSE 317 & IMSE 440' }, { label: 'Bid-performance reports', href: '/engineering/wooden-stone' }],
  },
  {
    area: 'Drawings & CAD',
    methods: 'Estimating from product drawings every week; CATIA V5 coursework; SolidWorks in training',
    evidence: [{ label: 'Estimating at The Wooden Stone', href: '/engineering/wooden-stone' }, { label: 'Engineering Computer Graphics' }],
  },
  {
    area: 'Automation & software',
    methods: 'Python, SQL, TypeScript, Excel modeling - the tools that make an improved process stick',
    evidence: [{ label: 'Operations platform', href: '/engineering/wooden-stone' }, { label: 'B.S. Game Development (CS)', href: '/games' }],
  },
];

const tools = [
  'Arena',
  'Minitab',
  'Siemens Jack',
  'AMPL',
  'Excel modeling',
  'Python',
  'SQL',
  'TypeScript',
  'CATIA V5',
  'SolidWorks (training)',
  'draw.io',
];
---

<Base
  title="Industrial Engineering - Juan Contreras"
  description="Industrial engineering work by Juan Contreras (B.S. ISE, UM-Dearborn): the estimating and capacity tools a Michigan countertop manufacturer runs on, plus ergonomics, Arena simulation, facility layout, and Six Sigma projects."
  current="engineering"
  ogImage="/images/og/engineering.png"
>
  <section class="section engineering">
    <div class="container">
      <span class="eyebrow">// industrial engineering</span>
      <h1 class="section-title">Industrial Engineering</h1>
      <p class="section-subtitle">
        B.S. in Industrial &amp; Systems Engineering from the University of Michigan-Dearborn. Since March 2025 I've
        worked at a Michigan countertop manufacturer - on the fabrication floor every week, estimating from product
        drawings, and building the estimating and operations software the shop runs on.
      </p>
      <div class="page-cta">
        <a href="/resume/engineering" class="btn btn-primary">IE résumé</a>
        <a href="/Juan_Contreras_Resume_Industrial_Engineer.pdf" class="btn btn-secondary" download>Download PDF</a>
        <a href="/contact" class="btn btn-secondary">Get in touch</a>
      </div>

      <h2 class="category-title">where I apply it now</h2>
      <article class="work-card">
        <div class="work-main">
          <span class="chip">{work.status}</span>
          <h3>{work.title}</h3>
          <p class="card-tech">{work.tech}</p>
          <p class="card-meta">{work.meta}</p>
          <ul class="card-bullets">
            {work.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <div class="card-tags">
            {work.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          <a class="card-link" href={`/engineering/${work.slug}`}>Full breakdown &rarr;</a>
        </div>
        <div class="work-formula" aria-label="How the estimating engine sizes fabrication time">
          <p class="formula-label">// how a job's fab time is sized</p>
          <p class="formula">fab days per trip =</p>
          <p class="formula formula-max">max(</p>
          <p class="formula formula-arg">saw load / saw per day,</p>
          <p class="formula formula-arg">CNC hours / CNC hours per day,</p>
          <p class="formula formula-arg">square feet / shop SF per day</p>
          <p class="formula formula-max">)</p>
          <p class="formula-note">The slowest resource sets the schedule - and the price.</p>
        </div>
      </article>

      <h2 class="category-title">engineering projects</h2>
      <div class="featured-grid">
        {
          featured.map((p) => (
            <article class="feature-card">
              {p.image && (
                <div class={`feature-media${p.image.fit === 'contain' ? ' fit-contain' : ''}`}>
                  <img src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} loading="lazy" />
                </div>
              )}
              <div class="feature-body">
                <span class="chip">{p.status}</span>
                <h3>{p.title}</h3>
                <p class="card-tech">{p.tech}</p>
                <p class="card-meta">{p.meta}</p>
                <ul class="card-bullets">
                  {p.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <div class="card-tags">
                  {p.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
                <a class="card-link" href={`/engineering/${p.slug}`}>
                  Full breakdown &rarr;
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <h2 class="category-title">the whole toolkit</h2>
      <p class="reach-intro">Every area of the degree, and where it shows up in my work.</p>
      <div class="reach-grid">
        {
          reach.map((r) => (
            <div class="reach-cell">
              <h3>{r.area}</h3>
              <p>{r.methods}</p>
              <ul class="reach-evidence">
                {r.evidence.map((e) => (
                  <li>{e.href ? <a href={e.href}>{e.label}</a> : <span>{e.label}</span>}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <h2 class="category-title">tools</h2>
      <div class="tool-row">
        {tools.map((t) => <span class="tag tag-lg">{t}</span>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .page-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.4rem;
  }

  .category-title {
    margin-top: 3rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-faint);
    text-transform: lowercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .category-title::before {
    content: '// ';
    color: var(--red-text);
  }

  .chip {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--red-text);
    border: 1px solid var(--red-text);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.55rem;
  }

  .card-tech {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--red-text);
    margin-top: 0.35rem;
  }

  .card-meta {
    font-size: 0.85rem;
    color: var(--text-faint);
    margin-top: 0.4rem;
  }

  .card-bullets {
    color: var(--text-muted);
    margin: 0.9rem 0 0 1.1rem;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.12rem 0.5rem;
  }

  .card-link {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--red-text);
    text-decoration: none;
    margin-top: auto;
    padding-top: 1.2rem;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  /* current work - wide card with the capacity formula */
  .work-card {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--red);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .work-main {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
  }

  .work-main h3 {
    font-size: 1.35rem;
    margin-top: 0.7rem;
    letter-spacing: -0.01em;
  }

  .work-formula {
    background: linear-gradient(135deg, var(--surface-2), var(--accent-soft));
    border-left: 1px solid var(--border);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-family: var(--mono);
  }

  .formula-label {
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-bottom: 0.9rem;
  }

  .formula {
    font-size: 0.9rem;
    color: var(--text);
    line-height: 1.6;
  }

  .formula-max {
    color: var(--red-text);
  }

  .formula-arg {
    padding-left: 1.4rem;
    color: var(--text-muted);
  }

  .formula-note {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  /* projects */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .feature-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: #fff;
  }

  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-media.fit-contain img {
    object-fit: contain;
    padding: 0.75rem;
  }

  .feature-body {
    padding: 1.5rem 1.6rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .feature-body h3 {
    font-size: 1.3rem;
    margin-top: 0.7rem;
    letter-spacing: -0.01em;
  }

  /* reach map */
  .reach-intro {
    color: var(--text-muted);
    margin-top: -0.4rem;
    margin-bottom: 1.2rem;
  }

  .reach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }

  .reach-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.25rem;
  }

  .reach-cell h3 {
    font-size: 0.98rem;
  }

  .reach-cell p {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-top: 0.45rem;
  }

  .reach-evidence {
    list-style: none;
    margin-top: 0.7rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .reach-evidence li {
    margin-top: 0.25rem;
    color: var(--text-faint);
  }

  .reach-evidence li::before {
    content: '▸ ';
    color: var(--red-text);
  }

  .reach-evidence a {
    color: var(--red-text);
    text-decoration: none;
  }

  .reach-evidence a:hover {
    text-decoration: underline;
  }

  .tool-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-lg {
    font-size: 0.8rem;
    padding: 0.25rem 0.7rem;
  }

  @media (max-width: 900px) {
    .work-card,
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .work-formula {
      border-left: none;
      border-top: 1px solid var(--border);
    }

    .reach-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .reach-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
