---
import Base from '../layouts/Base.astro';

const skills = [
  { group: 'Languages', items: 'C++ (primary), C#, TypeScript / JavaScript, SQL, Python, HTML/CSS' },
  { group: 'Engines & graphics', items: 'Unreal Engine 5 (C++), Unity, Vulkan API (Gateware), EnTT ECS, wxWidgets' },
  {
    group: 'Game systems',
    items: 'Enemy AI & behavior trees, player combat & movement, save/load & persistence, animation systems, inventory & game state, UI/menus',
  },
  {
    group: 'CS foundations',
    items: 'Data structures & algorithms, memory management / RAII, operating systems, computer architecture, networking, databases',
  },
  { group: 'Web & backend', items: 'Node.js / Express, REST APIs, MySQL, production deployment - two live business sites' },
  {
    group: 'Process',
    items: 'Git (documented branching strategies), Jira & Scrum, unit testing, code reviews, root-cause debugging',
  },
];

const credentials = [
  { line: 'B.S. Game Development - Full Sail University, Valedictorian (2026)' },
  { line: 'B.S. Industrial & Systems Engineering - University of Michigan-Dearborn (2023)' },
  { line: 'Web Development & IT Manager - The Wooden Stone, LLC (2025-present)' },
];
---

<Base
  title="Juan Contreras - Game Programmer & Software Developer"
  description="Game programmer in Detroit, MI - C++ and C# gameplay, AI, and save systems in Unreal Engine 5, Unity, and a custom Vulkan stack. B.S. Game Development, Full Sail valedictorian. View games, skills, and résumé."
  current="home"
>
  <!-- the site used to be tabbed on this page; forward old #hash links to the real routes -->
  <script is:inline>
    (function () {
      var h = location.hash.slice(1);
      if (h === 'games' || h === 'about' || h === 'contact') location.replace('/' + h);
      else if (h === 'home') history.replaceState(null, '', '/');
    })();
  </script>

  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="eyebrow">// game developer</span>
        <h1 class="hero-title">Juan Contreras</h1>
        <p class="hero-sub">Game Programmer &amp; Software Developer</p>
        <p class="hero-tagline">
          I build gameplay, AI, animation, and save systems in C++ and C# - across Unreal Engine 5, Unity, and a
          custom Vulkan stack. Four team games and a playable arcade shooter behind me; an engineer's process
          underneath all of it.
        </p>
        <ul class="hero-creds">
          {credentials.map((c) => <li>{c.line}</li>)}
        </ul>
        <div class="hero-cta">
          <a href="/games" class="btn btn-primary btn-large">View my games</a>
          <a href="/resume" class="btn btn-secondary btn-large">Résumé</a>
          <a href="/contact" class="btn btn-secondary btn-large">Get in touch</a>
        </div>
      </div>
      <img class="hero-mascot" src="/images/mascot.webp" alt="" width="613" height="560" loading="eager" />
    </div>
  </section>

  <section class="section skills">
    <div class="container">
      <span class="eyebrow">// what I work with</span>
      <h2 class="section-title">Tools &amp; systems</h2>
      <div class="skills-grid">
        {
          skills.map((s) => (
            <div class="skill">
              <h3>{s.group}</h3>
              <p>{s.items}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 4rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 2rem;
  }

  .hero-title {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .hero-sub {
    font-family: var(--mono);
    color: var(--red-text);
    font-size: 1.05rem;
    margin-top: 0.75rem;
  }

  .hero-tagline {
    color: var(--text-muted);
    max-width: 560px;
    margin-top: 1.1rem;
    font-size: 1.08rem;
  }

  .hero-creds {
    list-style: none;
    margin-top: 1.4rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .hero-creds li {
    margin-top: 0.4rem;
    padding-left: 1.2rem;
    position: relative;
  }

  .hero-creds li::before {
    content: '▸';
    color: var(--red-text);
    position: absolute;
    left: 0;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .hero-mascot {
    width: 100%;
    max-width: 360px;
    height: auto;
    justify-self: center;
    filter: drop-shadow(0 12px 26px rgba(0, 0, 0, 0.45));
  }

  :global(html.js[data-motion='full']) .hero-mascot {
    animation: bob 5s ease-in-out infinite;
  }

  @keyframes bob {
    50% {
      transform: translateY(-8px);
    }
  }

  /* skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .skill {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .skill h3 {
    font-size: 0.8rem;
    font-family: var(--mono);
    color: var(--text-faint);
    text-transform: lowercase;
    letter-spacing: 0.05em;
  }

  .skill h3::before {
    content: '// ';
    color: var(--red-text);
  }

  .skill p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-mascot {
      max-width: 260px;
      order: -1;
    }

    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
