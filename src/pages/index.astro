---
import Base from '../layouts/Base.astro';

// Two front doors: each side has its own landing page, case studies, and résumé, so an
// application can link straight to /engineering or /games.
const credentials = [
  { line: 'B.S. Industrial & Systems Engineering - University of Michigan-Dearborn (2023)' },
  { line: 'B.S. Game Development - Full Sail University, Valedictorian (2026)' },
  { line: 'Web Development & IT Manager - The Wooden Stone, LLC (2025-present)' },
];

const doors = [
  {
    key: 'engineering',
    eyebrow: 'industrial engineering',
    title: 'Industrial Engineering',
    blurb:
      'On the fabrication floor every week, estimating from product drawings, and building the estimating and operations software a Michigan countertop manufacturer runs on.',
    points: [
      'Estimating engine with shop-capacity limits - in production',
      'Senior design: pharmacy ergonomics, layout, and Arena simulation',
      'Six Sigma, simulation, facilities, operations research, economics',
    ],
    primary: { label: 'Engineering work', href: '/engineering' },
    secondary: { label: 'IE résumé', href: '/resume/engineering' },
  },
  {
    key: 'games',
    eyebrow: 'game development',
    title: 'Game Development',
    blurb:
      'Gameplay, AI, animation, and save systems in C++ and C# - across Unreal Engine 5, Unity, and a custom Vulkan stack.',
    points: [
      'Nutty Pursuit - a playable C++/Vulkan arcade game',
      'Four team games across three engines, verified against git',
      'Valedictorian, B.S. Game Development (computer science)',
    ],
    primary: { label: 'View my games', href: '/games' },
    secondary: { label: 'Game dev résumé', href: '/resume/games' },
  },
];
---

<Base
  title="Juan Contreras - Industrial Engineer & Game Programmer"
  description="Juan Contreras in Detroit, MI - industrial engineer (B.S. ISE, UM-Dearborn) building estimating and operations tools at a Michigan manufacturer, and game programmer (B.S. Game Development, Full Sail valedictorian). Engineering work, games, and résumés."
  current="home"
>
  <!-- the site used to be tabbed on this page; forward old #hash links to the real routes -->
  <script is:inline>
    (function () {
      var h = location.hash.slice(1);
      if (h === 'games' || h === 'about' || h === 'contact') location.replace('/' + h);
      else if (h === 'home') history.replaceState(null, '', '/');
    })();
  </script>

  <section class="hero section">
    <div class="container">
      <span class="eyebrow">// two engineering degrees</span>
      <h1 class="hero-title">Juan Contreras</h1>
      <p class="hero-sub">Industrial Engineer &amp; Game Programmer</p>
      <p class="hero-tagline">
        I learn how a process really works, measure it, and build what makes it work better - on a
        countertop shop floor in Michigan and inside C++ game engines. Pick the side you're hiring for.
      </p>
      <ul class="hero-creds">
        {credentials.map((c) => <li>{c.line}</li>)}
      </ul>

      <div class="doors">
        {
          doors.map((d) => (
            <article class={`door door-${d.key}`}>
              {d.key === 'games' && (
                <img class="door-mascot" src="/images/mascot.webp" alt="" width="613" height="560" loading="eager" />
              )}
              <span class="door-eyebrow">// {d.eyebrow}</span>
              <h2>{d.title}</h2>
              <p class="door-blurb">{d.blurb}</p>
              <ul class="door-points">
                {d.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <div class="door-cta">
                <a href={d.primary.href} class="btn btn-primary">
                  {d.primary.label} &rarr;
                </a>
                <a href={d.secondary.href} class="btn btn-secondary">
                  {d.secondary.label}
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <p class="hero-contact">
        Hiring for either? <a href="/contact">Get in touch</a> - Detroit, Michigan, open to relocation and remote.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 4rem;
  }

  .hero-title {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .hero-sub {
    font-family: var(--mono);
    color: var(--red-text);
    font-size: 1.05rem;
    margin-top: 0.75rem;
  }

  .hero-tagline {
    color: var(--text-muted);
    max-width: 640px;
    margin-top: 1.1rem;
    font-size: 1.08rem;
  }

  .hero-creds {
    list-style: none;
    margin-top: 1.4rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .hero-creds li {
    margin-top: 0.4rem;
    padding-left: 1.2rem;
    position: relative;
  }

  .hero-creds li::before {
    content: '▸';
    color: var(--red-text);
    position: absolute;
    left: 0;
  }

  /* the two front doors */
  .doors {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .door {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--red);
    border-radius: var(--radius);
    padding: 1.8rem 1.7rem 1.7rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .door-eyebrow {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .door h2 {
    font-size: 1.6rem;
    letter-spacing: -0.015em;
    margin-top: 0.4rem;
    max-width: 75%;
  }

  .door-blurb {
    color: var(--text-muted);
    margin-top: 0.7rem;
  }

  .door-points {
    color: var(--text-muted);
    margin: 1rem 0 0 1.1rem;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .door-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .door-mascot {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 92px;
    height: auto;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.4));
  }

  :global(html.js[data-motion='full']) .door-mascot {
    animation: bob 5s ease-in-out infinite;
  }

  @keyframes bob {
    50% {
      transform: translateY(-6px);
    }
  }

  .hero-contact {
    margin-top: 2rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .hero-contact a {
    color: var(--red-text);
  }

  @media (max-width: 900px) {
    .doors {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .door-mascot {
      width: 68px;
    }
  }
</style>
